# Load dplyr for easier data manipulation
library(dplyr)
# Summarize the counts of each rating by user type
rating_counts <- data %>%
group_by(user, rating) %>%
summarise(count = n()) %>%
ungroup()
# Spread the counts into a wide format (one column per user type)
rating_table <- rating_counts %>%
tidyr::pivot_wider(names_from = user, values_from = count, values_fill = 0)
# Add a row for total counts per rating
rating_table$total <- rowSums(rating_table[ ,c("regular", "influencer")])
# Create a table of proportions (divide each count by the total)
proportion_table <- rating_table %>%
mutate(regular_prop = regular / total,
influencer_prop = influencer / total)
# Print the table of proportions (keeping only necessary columns)
proportion_table <- proportion_table %>%
select(rating, regular_prop, influencer_prop)
print(proportion_table)
