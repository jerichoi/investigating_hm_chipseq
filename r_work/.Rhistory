# Load necessary libraries
library(dplyr)
library(tidyr)
# Summarize the counts of each rating by user type
rating_counts <- data %>%
group_by(user, rating) %>%
summarise(count = n()) %>%
ungroup()
# Spread the counts into a wide format (one column per user type)
rating_table <- rating_counts %>%
pivot_wider(names_from = user, values_from = count, values_fill = 0)
# Calculate the total counts for each user type (column sums)
user_totals <- colSums(rating_table[ ,c("regular", "influencer")])
# Create a table of proportions (divide each count by the respective column total)
proportion_table <- rating_table %>%
mutate(regular_prop = regular / user_totals["regular"],
influencer_prop = influencer / user_totals["influencer"])
# Select only the necessary columns
proportion_table <- proportion_table %>%
select(rating, regular_prop, influencer_prop)
# Print the table of proportions
print(proportion_table)
